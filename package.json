{
  "name": "conditional-call-flow",
  "displayName": "Conditional Call Flow",
  "description": "See how C# code flows: function calls labelled with their branch conditions, and class flow — inheritance, DI registrations (AddScoped/AddSingleton), constructor injection and where objects are created.",
  "version": "0.2.0",
  "publisher": "vtzy137",
  "license": "MIT",
  "icon": "media/icon.png",
  "keywords": [
    "call graph",
    "control flow",
    "csharp",
    "roslyn",
    "visualization",
    "dotnet",
    "dependency injection",
    "asp.net core",
    "class diagram",
    "architecture"
  ],
  "galleryBanner": {
    "color": "#0b3d91",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:csharp",
    "workspaceContains:**/*.csproj"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "flowVisualizerContainer",
          "title": "Code Flow",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "flowVisualizerContainer": [
        {
          "id": "flowVisualizer.functionsSidebar",
          "name": "Active File"
        }
      ]
    },
    "commands": [
      {
        "command": "flowVisualizer.refreshSidebar",
        "title": "Refresh Functions",
        "category": "Code Flow",
        "icon": "$(refresh)"
      },
      {
        "command": "flowVisualizer.reloadWorkspace",
        "title": "Reload Workspace (re-read .sln/.csproj)",
        "category": "Code Flow",
        "icon": "$(sync)"
      },
      {
        "command": "flowVisualizer.showFlowAtCursor",
        "title": "Show Call Flow for Function at Cursor",
        "category": "Code Flow",
        "icon": "$(type-hierarchy-sub)"
      },
      {
        "command": "flowVisualizer.selectRootFunction",
        "title": "Show Call Flow",
        "category": "Code Flow"
      },
      {
        "command": "flowVisualizer.showClassFlowAtCursor",
        "title": "Show Class Flow for Type at Cursor",
        "category": "Code Flow",
        "icon": "$(symbol-class)"
      },
      {
        "command": "flowVisualizer.selectRootClass",
        "title": "Show Class Flow",
        "category": "Code Flow"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "flowVisualizer.refreshSidebar",
          "when": "view == flowVisualizer.functionsSidebar",
          "group": "navigation"
        },
        {
          "command": "flowVisualizer.reloadWorkspace",
          "when": "view == flowVisualizer.functionsSidebar",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "flowVisualizer.showFlowAtCursor",
          "when": "editorLangId == csharp",
          "group": "navigation@99"
        },
        {
          "command": "flowVisualizer.showClassFlowAtCursor",
          "when": "editorLangId == csharp",
          "group": "navigation@99"
        }
      ],
      "commandPalette": [
        {
          "command": "flowVisualizer.selectRootFunction",
          "when": "false"
        },
        {
          "command": "flowVisualizer.selectRootClass",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Conditional Call Flow",
      "properties": {
        "codeFlow.initialDepth": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 6,
          "description": "How many call levels to load when a root function is selected. Deeper levels load on demand (right-click a node)."
        },
        "codeFlow.classInitialDepth": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 6,
          "description": "How many levels the class flow follows automatically (dependencies, implementations, base classes). Consumers and creators of a class are shown for each expanded class but not followed."
        },
        "codeFlow.csharp.solutionPath": {
          "type": "string",
          "default": "",
          "description": "Path to the .sln/.slnx/.csproj to analyze (absolute or relative to the workspace folder). Empty = auto-detect."
        },
        "codeFlow.csharp.dotnetPath": {
          "type": "string",
          "default": "dotnet",
          "description": "dotnet executable used to run the Roslyn analyzer daemon."
        },
        "codeFlow.ignorePatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "\\.Log(Debug|Info|Information|Warning|Error|Trace|Critical)$",
            "Logger\\."
          ],
          "description": "Regular expressions matched against 'Namespace.Type.Method'. Matching calls are hidden from the graph. Framework (System.*, Microsoft.*) calls are always hidden."
        },
        "codeFlow.layoutDirection": {
          "type": "string",
          "enum": [
            "TB",
            "LR"
          ],
          "default": "TB",
          "description": "Graph direction: top-to-bottom or left-to-right."
        }
      }
    }
  },
  "scripts": {
    "build:analyzer": "dotnet build analyzer-csharp/RoslynDaemon.csproj -c Release -o dist/analyzer",
    "copy-libs": "node scripts/copy-libs.js",
    "compile": "npm run copy-libs && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build": "npm run build:analyzer && npm run compile",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.1",
    "cytoscape": "3.30.4",
    "cytoscape-dagre": "2.5.0",
    "dagre": "0.8.5",
    "typescript": "^5.6.3"
  }
}
